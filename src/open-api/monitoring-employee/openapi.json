{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "database": "up"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/employees": {
      "post": {
        "operationId": "EmployeesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployeeDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Tambah karyawan dan sinkronkan akun ke attendance service",
        "tags": [
          "employees"
        ]
      },
      "get": {
        "operationId": "EmployeesController_findAll",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 20,
              "minimum": 1
            }
          },
          {
            "name": "isActive",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeePageResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Daftar karyawan",
        "tags": [
          "employees"
        ]
      }
    },
    "/api/v1/employees/{id}": {
      "get": {
        "operationId": "EmployeesController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "tags": [
          "employees"
        ]
      },
      "patch": {
        "operationId": "EmployeesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmployeeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Update data atau reset password karyawan",
        "tags": [
          "employees"
        ]
      },
      "delete": {
        "operationId": "EmployeesController_deactivate",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployeeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Nonaktifkan karyawan (soft delete)",
        "tags": [
          "employees"
        ]
      }
    },
    "/api/v1/attendances": {
      "get": {
        "operationId": "AttendancesController_findAll",
        "parameters": [
          {
            "name": "employeeId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-08-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "example": "2026-08-29",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendancePageResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Lihat absensi seluruh karyawan (read-only)",
        "tags": [
          "attendances"
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "operationId": "NotificationsController_list",
        "parameters": [
          {
            "name": "unreadOnly",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NotificationResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/{id}/read": {
      "patch": {
        "operationId": "NotificationsController_markRead",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/devices": {
      "post": {
        "operationId": "NotificationsController_registerDevice",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDeviceResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "summary": "Daftarkan FCM token browser admin",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/devices/{id}": {
      "delete": {
        "operationId": "NotificationsController_removeDevice",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/audit-logs": {
      "get": {
        "operationId": "NotificationsController_listAuditLogs",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "admin-api-key": []
          }
        ],
        "tags": [
          "notifications"
        ]
      }
    }
  },
  "info": {
    "title": "Dexa Group Monitoring Employee API",
    "description": "REST API admin HRD untuk master karyawan, absensi read-only, audit, dan notifikasi.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "admin-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-api-key"
      }
    },
    "schemas": {
      "CreateEmployeeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "employee@dexagroup.com"
          },
          "name": {
            "type": "string",
            "example": "Budi Santoso"
          },
          "position": {
            "type": "string",
            "example": "Software Engineer"
          },
          "phoneNumber": {
            "type": "string",
            "example": "081234567890"
          },
          "photoUrl": {
            "type": "string",
            "example": "https://cdn.example.com/photo.jpg"
          },
          "initialPassword": {
            "type": "string",
            "minLength": 8,
            "description": "Dikirim sekali ke attendance service dan tidak disimpan di monitoring DB"
          }
        },
        "required": [
          "email",
          "name",
          "position",
          "initialPassword"
        ]
      },
      "EmployeeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "position",
          "phoneNumber",
          "photoUrl",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "EmployeePaginationDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "EmployeePageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployeeResponseDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/EmployeePaginationDto"
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "UpdateEmployeeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "employee@dexagroup.com"
          },
          "name": {
            "type": "string",
            "example": "Budi Santoso"
          },
          "position": {
            "type": "string",
            "example": "Software Engineer"
          },
          "phoneNumber": {
            "type": "string",
            "example": "081234567890"
          },
          "photoUrl": {
            "type": "string",
            "example": "https://cdn.example.com/photo.jpg"
          }
        }
      },
      "AttendanceEmployeeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "AttendanceRecordResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceAttendanceId": {
            "type": "string",
            "format": "uuid"
          },
          "employeeId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECK_IN",
              "CHECK_OUT"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "workDate": {
            "type": "string",
            "format": "date"
          },
          "sourceIdempotencyKey": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "employee": {
            "$ref": "#/components/schemas/AttendanceEmployeeDto"
          }
        },
        "required": [
          "id",
          "sourceAttendanceId",
          "employeeId",
          "type",
          "occurredAt",
          "workDate",
          "sourceIdempotencyKey",
          "createdAt",
          "employee"
        ]
      },
      "AttendancePaginationDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "AttendancePageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttendanceRecordResponseDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/AttendancePaginationDto"
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "NotificationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "employeeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "readAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "eventId",
          "employeeId",
          "title",
          "message",
          "data",
          "readAt",
          "createdAt"
        ]
      },
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Firebase Cloud Messaging registration token"
          },
          "label": {
            "type": "string",
            "example": "Chrome - HR Admin"
          }
        },
        "required": [
          "token"
        ]
      },
      "AdminDeviceResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "token",
          "label",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  }
}
